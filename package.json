{
  "name": "sonarr",
  "version": "4.0.0",
  "description": "Sonarr is a PVR for Usenet and BitTorrent users",
  "scripts": {
    "build": "vite build",
    "prebuild": "yarn clean",
    "clean": "rimraf ./_output/UI && rimraf --glob \"**/*.js.map\"",
    "start": "vite",
    "watch": "vite build --watch",
    "types:css": "tcm frontend/src --camelCase --pattern \"**/*.module.css\"",
    "typecheck": "yarn types:css && tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint --config frontend/.eslintrc.js --ignore-path frontend/.eslintignore frontend/",
    "lint-fix": "yarn lint --fix",
    "stylelint": "stylelint \"frontend/**/*.css\" --config frontend/.stylelintrc"
  },
  "repository": "https://github.com/Sonarr/Sonarr",
  "author": "Team Sonarr",
  "license": "GPL-3.0",
  "readmeFilename": "readme.md",
  "main": "index.ts",
