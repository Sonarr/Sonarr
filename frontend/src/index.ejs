<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Chrome, Opera, and Firefox OS -->
    <meta name="theme-color" content="#3a3f51" />
    <!-- Windows Phone -->
    <meta name="msapplication-navbutton-color" content="#3a3f51" />
    <!-- Android/Apple Phone -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no">

    <meta name="description" content="Sonarr" />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/Content/Images/Icons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/Content/Images/Icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/Content/Images/Icons/favicon-16x16.png"
    />
    <link rel="manifest" href="/Content/manifest.json" crossorigin="use-credentials" />
    <link
      rel="mask-icon"
      href="/Content/Images/Icons/safari-pinned-tab.svg"
      color="#00ccff"
    />
    <link
      rel="shortcut icon"
      type="image/ico"
      href="/favicon.ico"
      data-no-hash
    />
    <meta
      name="msapplication-config"
      content="/Content/browserconfig.xml"
    />

    <script>
      (function applyInitialTheme() {
        var supportedThemes = ['auto', 'light', 'dark', 'oled'];
        var storageKey = 'sonarr.ui.theme';
        var selectedTheme = '__THEME__';

        try {
          var storedTheme = window.localStorage.getItem(storageKey);

          if (supportedThemes.indexOf(storedTheme) !== -1) {
            selectedTheme = storedTheme;
          }
        } catch (error) {
          // Storage can be unavailable in private or restricted contexts.
        }

        if (supportedThemes.indexOf(selectedTheme) === -1) {
          selectedTheme = 'auto';
        }

        var prefersDark = window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolvedTheme = selectedTheme === 'oled'
          ? 'oled'
          : selectedTheme === 'dark' || (selectedTheme === 'auto' && prefersDark)
            ? 'dark'
            : 'light';
        var themeColor = resolvedTheme === 'oled'
          ? '#000000'
          : resolvedTheme === 'dark'
            ? '#2a2a2a'
            : '#3a3f51';
        var pageBackground = resolvedTheme === 'oled'
          ? '#000000'
          : resolvedTheme === 'dark'
            ? '#202020'
            : '#f5f7fa';
        var documentElement = document.documentElement;

        documentElement.dataset.theme = selectedTheme;
        documentElement.dataset.resolvedTheme = resolvedTheme;
        documentElement.style.colorScheme = resolvedTheme === 'light' ? 'light' : 'dark';
        documentElement.style.backgroundColor = pageBackground;
        documentElement.style.setProperty('--pageBackground', pageBackground);

        document
          .querySelectorAll('meta[name="theme-color"], meta[name="msapplication-navbutton-color"]')
          .forEach(function setThemeColor(element) {
            element.setAttribute('content', themeColor);
          });

        window.Sonarr = {
          urlBase: '__URL_BASE__',
          theme: selectedTheme
        };
      })();
    </script>

    __MINI_PROFILER__

    <link rel="stylesheet" type="text/css" href="/Content/Fonts/fonts.css">

    <% for (key in htmlWebpackPlugin.files.js) { %><script type="text/javascript" src="<%= htmlWebpackPlugin.files.js[key] %>" data-no-hash></script><% } %>
    <% for (key in htmlWebpackPlugin.files.css) { %><link href="<%= htmlWebpackPlugin.files.css[key] %>" rel="stylesheet"></link><% } %>

    <title>Sonarr</title>

    <!--
      The super basic styling for .root  will live here,
      saves fighting with CSS Modules for ~10 lines
    -->
    <style>
      html {
        background-color: var(--pageBackground);
      }

      .root {
        min-width: 0;
        height: 100%; /* needed for proper layout */
        background-color: var(--pageBackground);
      }

      @media only screen and (max-width: 768px) {
        .root {
          display: flex;
          flex-direction: column;
          min-height: 100%;
          height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div id="portal-root"></div>
    <div id="root" class="root"></div>
  </body>
</html>
